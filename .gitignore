# Política del repo: el repositorio ES el paquete que descargan las fábricas
# (update.bat baja el ZIP de la rama). Solo se versiona lo que se despliega
# y los manuales de uso; nada técnico, de arquitectura ni de diseño.

# ── Dependencias ──────────────────────────────────────────────
node_modules/

# ── Datos de runtime (generados por setup.js, nunca en repo) ──
/data/
/logs/
*.db
*.db-shm
*.db-wal

# ── Secretos y entorno (no puede fallar) ──────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*.json
*service-account*.json
settings.local.json

# ── Documentación técnica, de arquitectura y diseño (solo local)
/README.md
/CLAUDE.md
/AGENTS.md
/TODO.md
project-doc/
# docs/: solo manuales de uso
/docs/*
!/docs/INSTALL.md
!/docs/USER_GUIDE.md
!/docs/manuales/

# ── Release locales ───────────────────────────────────────────
release/

# ── Herramientas de agentes IA ────────────────────────────────
.agents/
.claude/

# ── Prerrequisitos (binarios pesados, se distribuyen aparte) ──
prereqs/

# ── Archivos temporales / OS ──────────────────────────────────
temp/
*.tmp
Thumbs.db
.DS_Store
desktop.ini

# ── Archivo suelto de query de desarrollo ────────────────────
query
